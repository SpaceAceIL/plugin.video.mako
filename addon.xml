<?xml version="5.1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.mako" name="Israeli TV" version="5.0.0" provider-name="SpaceAce">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
    <import addon="inputstream.adaptive" version="2.4.0" optional="true"/>
  </requires>
  <extension point="xbmc.service" library="service.py" start="startup"/>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Israeli TV — live channels + EPG</summary>
    <description lang="en_GB">Live Israeli TV channels (Kan 11, Keshet 12, Channel 13, Channel 14, Makan 33, Kan Educational, Knesset) with EPG. Made by SpaceAce.</description>
    <disclaimer lang="en_GB">Made by SpaceAce. Not affiliated with Mako or Keshet.</disclaimer>
    <platform>all</platform>
    <license>GPL-2.0-only</license>
    <source>https://github.com/SpaceAceIL/plugin.video.mako</source>
    <assets>
      <icon>https://uxwing.com/wp-content/themes/uxwing/download/flags-landmarks/israel-flag-round-circle-icon.svg</icon>
      <fanart>https://uxwing.com/wp-content/themes/uxwing/download/flags-landmarks/israel-flag-round-circle-icon.svg</fanart>
    </assets>
  </extension>
</addon>
